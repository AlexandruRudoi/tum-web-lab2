---
// Decap CMS admin panel — served at /admin/
// config.yml lives at public/admin/config.yml → served at /admin/config.yml
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Content Manager – RTS GeoServer</title>
    <script is:inline>
      // Unregister any stale service workers from previous CMS deployments
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then(regs => {
          regs.forEach(r => r.unregister());
        });
      }
    </script>
  </head>
  <body>
    <script is:inline src="https://unpkg.com/@sveltia/cms/dist/sveltia-cms.js"></script>
  </body>
</html>
