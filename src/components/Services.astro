---
import { getCollection } from 'astro:content';
interface Props { lang: string; }
const { lang } = Astro.props;
const services = (await getCollection('services'))
  .filter((s) => s.id.startsWith(`${lang}/`))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<section id="services" class="bg-slate-50 py-16">
  <div class="max-w-6xl mx-auto px-5">
    <h2 class="text-center text-4xl font-bold text-dark mb-4">Our Solutions</h2>
    <p class="text-center text-xl text-muted mb-12">Comprehensive GIS platform tailored for your business needs</p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {services.map((service) => (
        <div class="bg-white p-8 rounded-lg shadow-md hover:-translate-y-1 hover:shadow-lg transition-all">
          <h3 class="text-2xl font-semibold text-dark mb-4">{service.data.title}</h3>
          <p class="text-muted leading-relaxed">{service.data.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
