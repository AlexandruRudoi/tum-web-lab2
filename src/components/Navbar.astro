---
interface Props { lang?: string; }
const { lang = 'en' } = Astro.props;

const labels = {
  en: { home: 'Home', about: 'About', services: 'Services', benefits: 'Why Us', testimonials: 'Reviews', cta: 'Get Started' },
  ro: { home: 'Acasă', about: 'Despre', services: 'Soluții', benefits: 'De ce Noi', testimonials: 'Recenzii', cta: 'Începeți' },
  ru: { home: 'Главная', about: 'О нас', services: 'Решения', benefits: 'Почему Мы', testimonials: 'Отзывы', cta: 'Начать' },
} as const;

const t = labels[lang as keyof typeof labels] ?? labels.en;

const langOptions = [
  { code: 'en', href: '/',    label: { en: 'English', ro: 'Engleză',  ru: 'Английский' } },
  { code: 'ro', href: '/ro/', label: { en: 'Romanian', ro: 'Română',  ru: 'Румынский'  } },
  { code: 'ru', href: '/ru/', label: { en: 'Russian',  ro: 'Rusă',    ru: 'Русский'    } },
] as const;
const current = langOptions.find(o => o.code === lang) ?? langOptions[0];
---

<nav class="sticky top-0 z-50 bg-white shadow-sm">
  <input type="checkbox" id="menu-toggle" class="hidden" />
  <div class="max-w-6xl mx-auto px-5 flex justify-between items-center h-16">
    <div class="logo">
      <img src="/images/logo.png" alt="RTS Logo" class="h-12 w-auto" />
    </div>
    <ul class="hidden lg:flex gap-8 items-center list-none m-0 p-0">
      <li><a href="#hero" class="text-dark font-medium hover:text-primary transition-colors no-underline">{t.home}</a></li>
      <li><a href="#about" class="text-dark font-medium hover:text-primary transition-colors no-underline">{t.about}</a></li>
      <li><a href="#services" class="text-dark font-medium hover:text-primary transition-colors no-underline">{t.services}</a></li>
      <li><a href="#benefits" class="text-dark font-medium hover:text-primary transition-colors no-underline">{t.benefits}</a></li>
      <li><a href="#testimonials" class="text-dark font-medium hover:text-primary transition-colors no-underline">{t.testimonials}</a></li>
      <li><a href="#contact" class="bg-primary text-white px-5 py-2 rounded font-medium hover:bg-primary-dark transition-colors no-underline">{t.cta}</a></li>
      <li class="relative">
        <details class="relative lang-switcher">
          <summary class="flex items-center gap-1.5 text-sm font-medium text-gray-700 bg-slate-100 hover:bg-slate-200 transition-colors select-none rounded px-2.5 py-1 cursor-pointer">
            <span class="font-medium">{current.code.toUpperCase()}</span>
            <svg class="w-3 h-3 opacity-40" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </summary>
          <ul class="absolute right-0 top-full mt-1.5 bg-white border border-slate-200 rounded-lg shadow-lg py-1.5 min-w-[150px] z-50 list-none m-0">
            {langOptions.map(o => (
              <li>
                <a
                  href={o.href}
                  class={`flex items-center gap-2.5 px-3 py-2 no-underline transition-colors rounded-md mx-1 ${o.code === lang ? 'text-dark font-semibold' : 'text-slate-500 hover:bg-slate-50 hover:text-dark'}`}
                >
                  <span class="text-sm">{o.code.toUpperCase()}</span>
                  <span class="text-sm">{o.label[lang as keyof typeof o.label]}</span>
                </a>
              </li>
            ))}
          </ul>
        </details>
      </li>
    </ul>
    <label for="menu-toggle" class="lg:hidden flex flex-col gap-1.5 p-2 cursor-pointer" aria-label="Toggle menu">
      <span class="block w-6 h-0.5 bg-dark transition-all"></span>
      <span class="block w-6 h-0.5 bg-dark transition-all"></span>
      <span class="block w-6 h-0.5 bg-dark transition-all"></span>
    </label>
  </div>
  <div class="mobile-menu bg-white border-t border-slate-100 px-5 py-4">
    <ul class="flex flex-col gap-4 list-none m-0 p-0">
      <li><a href="#hero" class="text-dark font-medium hover:text-primary transition-colors no-underline">{t.home}</a></li>
      <li><a href="#about" class="text-dark font-medium hover:text-primary transition-colors no-underline">{t.about}</a></li>
      <li><a href="#services" class="text-dark font-medium hover:text-primary transition-colors no-underline">{t.services}</a></li>
      <li><a href="#benefits" class="text-dark font-medium hover:text-primary transition-colors no-underline">{t.benefits}</a></li>
      <li><a href="#testimonials" class="text-dark font-medium hover:text-primary transition-colors no-underline">{t.testimonials}</a></li>
      <li><a href="#contact" class="inline-block bg-primary text-white px-5 py-2 rounded font-medium hover:bg-primary-dark transition-colors no-underline">{t.cta}</a></li>
      <li class="pt-2 border-t border-slate-100">
        <details class="lang-switcher">
          <summary class="flex items-center gap-1.5 text-sm font-medium text-gray-700 bg-slate-100 hover:bg-slate-200 transition-colors select-none rounded px-2.5 py-1 cursor-pointer w-fit">
            <span class="font-medium">{current.code.toUpperCase()}</span>
            <svg class="w-3 h-3 opacity-40" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </summary>
          <ul class="mt-1.5 bg-white border border-slate-200 rounded-lg shadow-lg py-1.5 list-none m-0">
            {langOptions.map(o => (
              <li>
                <a
                  href={o.href}
                  class={`flex items-center gap-2.5 px-3 py-2 no-underline transition-colors rounded-md mx-1 ${o.code === lang ? 'text-dark font-semibold' : 'text-slate-500 hover:bg-slate-50 hover:text-dark'}`}
                >
                  <span class="text-sm">{o.code.toUpperCase()}</span>
                  <span class="text-sm">{o.label[lang as keyof typeof o.label]}</span>
                </a>
              </li>
            ))}
          </ul>
        </details>
      </li>
    </ul>
  </div>
</nav>

