---
import { getCollection } from 'astro:content';
interface Props { lang: string; }
const { lang } = Astro.props;
const benefits = (await getCollection('benefits'))
  .filter((b) => b.id.startsWith(`${lang}/`))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<section id="benefits" class="bg-white py-16">
  <div class="max-w-6xl mx-auto px-5">
    <h2 class="text-center text-4xl font-bold text-dark mb-12">Why Choose GeoServer RTS?</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
      {benefits.map((benefit) => (
        <div class="text-center p-8">
          <h3 class="text-xl font-semibold text-dark mb-4">{benefit.data.title}</h3>
          <p class="text-muted leading-relaxed">{benefit.data.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
