---
import { getEntry } from 'astro:content';
const { data: about } = await getEntry('site', 'about');
---

<section id="about" class="bg-white py-16">
  <div class="max-w-6xl mx-auto px-5">
    <h2 class="text-center text-4xl font-bold text-dark mb-12">{about.section_title}</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 items-center">
      <div class="col-span-2">
        <h3 class="text-3xl font-semibold text-dark mb-4">{about.heading}</h3>
        <p class="mb-4 text-lg leading-relaxed">{about.paragraph1}</p>
        <p class="text-lg leading-relaxed">{about.paragraph2}</p>
      </div>
      <div class="flex flex-col gap-8">
        <div class="text-center p-6 bg-white rounded-lg shadow-md">
          <h4 class="text-4xl font-bold text-primary mb-2">{about.stat1_value}</h4>
          <p class="text-dark font-medium">{about.stat1_label}</p>
        </div>
        <div class="text-center p-6 bg-white rounded-lg shadow-md">
          <h4 class="text-4xl font-bold text-primary mb-2">{about.stat2_value}</h4>
          <p class="text-dark font-medium">{about.stat2_label}</p>
        </div>
        <div class="text-center p-6 bg-white rounded-lg shadow-md">
          <h4 class="text-4xl font-bold text-primary mb-2">{about.stat3_value}</h4>
          <p class="text-dark font-medium">{about.stat3_label}</p>
        </div>
      </div>
    </div>
  </div>
</section>
