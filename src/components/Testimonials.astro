---
import { getCollection } from 'astro:content';
interface Props { lang: string; }
const { lang } = Astro.props;
const testimonials = (await getCollection('testimonials')).filter((t) =>
  t.id.startsWith(`${lang}/`)
);
---

<section id="testimonials" class="bg-slate-50 py-16">
  <div class="max-w-6xl mx-auto px-5">
    <h2 class="text-center text-4xl font-bold text-dark mb-12">What Our Clients Say</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {testimonials.map((t) => (
        <div class="bg-white p-8 rounded-lg shadow-md">
          <div class="text-xl mb-4">⭐⭐⭐⭐⭐</div>
          <p class="text-muted italic leading-relaxed mb-6">"{t.data.quote}"</p>
          <p class="text-dark font-semibold">- {t.data.author}</p>
        </div>
      ))}
    </div>
  </div>
</section>
