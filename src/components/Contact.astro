<section id="contact" class="bg-white py-16">
  <div class="max-w-6xl mx-auto px-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16">
      <div>
        <h2 class="text-3xl font-bold text-dark mb-4">Ready to Transform Your GIS Workflow?</h2>
        <p class="text-muted mb-8 leading-relaxed">Contact us today for a consultation and demo. Our team will help you implement the perfect GIS solution for your business needs.</p>
        <div>
          <p class="mb-4 text-muted leading-relaxed">
            <strong class="text-dark font-semibold">Email:</strong>
            <a href="mailto:office@rts.md" class="text-primary hover:text-primary-dark hover:underline transition-colors">office@rts.md</a>
          </p>
          <p class="mb-4 text-muted leading-relaxed">
            <strong class="text-dark font-semibold">Phone:</strong>
            <a href="tel:+37322101777" class="text-primary hover:text-primary-dark hover:underline transition-colors">+373 22 101-777</a>
            /
            <a href="tel:+37379101777" class="text-primary hover:text-primary-dark hover:underline transition-colors">+373 79 101-777</a>
          </p>
          <p class="mb-4 text-muted leading-relaxed">
            <strong class="text-dark font-semibold">Address:</strong>
            <a href="https://www.google.com/maps?ll=47.030667,28.836537&z=16&t=m&hl=ro&gl=US&mapclient=embed&q=Bloc+B+Strada+Mitropolit+Gavriil+B%C4%83nulescu-Bodoni+59+MD-2005,+Chi%C8%99in%C4%83u" target="_blank" class="text-primary hover:text-primary-dark hover:underline transition-colors">str. Mitropolit G. B&#259;nulescu-Bodoni 59/B, of. 815, mun. Chi&#537;in&#259;u, MD-2005, Republica Moldova</a>
          </p>
          <p class="text-muted leading-relaxed"><strong class="text-dark font-semibold">Hours:</strong> Luni-Vineri 09:00-18:00</p>
        </div>
      </div>
      <div>
        <h3 class="text-2xl font-semibold text-dark mb-6">Request a Demo</h3>
        <form class="flex flex-col gap-4">
          <input type="text" placeholder="Your Name" required class="p-4 border border-slate-200 rounded text-base focus:outline-none focus:border-primary transition-colors" />
          <input type="email" placeholder="Your Email" required class="p-4 border border-slate-200 rounded text-base focus:outline-none focus:border-primary transition-colors" />
          <input type="tel" placeholder="Phone Number" required class="p-4 border border-slate-200 rounded text-base focus:outline-none focus:border-primary transition-colors" />
          <select required class="p-4 border border-slate-200 rounded text-base focus:outline-none focus:border-primary transition-colors">
            <option value="">Industry / Service Type</option>
            <option value="government">Government / Municipality</option>
            <option value="real-estate">Real Estate</option>
            <option value="agriculture">Agriculture</option>
            <option value="utilities">Utilities &amp; Infrastructure</option>
            <option value="logistics">Logistics &amp; Transportation</option>
            <option value="other">Other</option>
          </select>
          <textarea placeholder="Tell us about your GIS requirements..." rows="4" class="p-4 border border-slate-200 rounded text-base focus:outline-none focus:border-primary transition-colors"></textarea>
          <button type="submit" class="p-4 bg-primary text-white rounded text-base font-semibold cursor-pointer hover:bg-primary-dark transition-colors border-0 outline-none">Send Request</button>
        </form>
      </div>
    </div>
  </div>
</section>
